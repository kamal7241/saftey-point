{
  "compilerOptions": {
    "baseUrl": "./src",
    "target": "ES2022", // Align with Angular's internal settings
    "module": "es2020",
    "moduleResolution": "node",
    "sourceMap": true,
    "outDir": "./dist/out-tsc",
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "importHelpers": true,
    "typeRoots": ["node_modules/@types", "node_modules/@popperjs/core"],
    "lib": ["es2018", "dom"],
    "paths": {
      "@core": ["@core/"],
      "@fake-db": ["@fake-db/"],
      "environments": ["environments/"]
    }
  },
  "angularCompilerOptions": {
    "fullTemplateTypeCheck": false,
    "strictInjectionParameters": false
  }
}
