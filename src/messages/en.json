  "about_page": {
    "title": "About Safety Dashboard",
    "back_to_dashboard": "← Back to Dashboard",
    "mission_title": "Our Mission",
    "mission_text": "Safety Dashboard is a comprehensive platform designed to revolutionize how organizations manage and monitor workplace safety. Our mission is to create safer work environments through data-driven insights and proactive safety measures.",
    "what_we_do_title": "What We Do",
    "what_we_do_text": "We provide real-time monitoring, advanced analytics, and actionable insights to help organizations identify potential safety risks before they become incidents. Our platform combines cutting-edge technology and industry best practices to deliver a robust safety management solution.",
    "commitment_title": "Our Commitment",
    "commitment_text": "Safety isn't just a priority - it's a core value. We are committed to continuous improvement and innovation in workplace safety management. By leveraging the latest technology and industry expertise, we help organizations build a strong safety culture and achieve their safety goals.",
    "contact_us_title": "Contact Us",
    "contact_us_text": "Have questions about how we can help improve safety in your organization? We'd love to hear from you. Get in touch with our team of safety experts, and we'll be happy to discuss your specific needs and requirements."
  },
  "support_page": {
    "title": "Support Center",
    "back_to_dashboard": "← Back to Dashboard",
    "getting_started_title": "Getting Started",
    "getting_started_text": "Welcome to our Support Center. Here you'll find everything you need to get started with our Safety Dashboard. Our platform is designed to help you effectively monitor and manage workplace safety.",
    "common_questions_title": "Common Questions",
    "common_questions_text": "Having trouble navigating the dashboard? Our comprehensive FAQ section covers the most common questions about using the platform, managing reports, and accessing analytics. If you can't find what you're looking for, don't hesitate to reach out to our support team.",
    "contact_support_title": "Contact Support",
    "contact_support_text": "Our dedicated support team is available 24/7 to help you with any issues you may encounter. You can reach us via email at support@safetydashboard.com or use our live chat feature during business hours.",
    "resources_title": "Resources",
    "resources_text": "Access our library of tutorials, guides, and best practices to get the most out of your Safety Dashboard. We regularly update our resources to ensure you have the latest information and tips for managing workplace safety."
  },
